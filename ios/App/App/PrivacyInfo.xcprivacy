<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Cove does not track users or share data with third parties. -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>
	<!-- No health or personal data is collected or transmitted. Everything stays on device. -->
	<key>NSPrivacyCollectedDataTypes</key>
	<array/>
	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!-- Capacitor Preferences plugin and WKWebView localStorage both use UserDefaults. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- CA92.1: reading/writing the app's own first-party preferences data -->
				<string>CA92.1</string>
			</array>
		</dict>
		<!-- SQLCipher and the Filesystem plugin read file timestamps on files the app created. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryFileTimestamp</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- C617.1: file timestamps on files this app itself wrote -->
				<string>C617.1</string>
			</array>
		</dict>
		<!-- Capacitor checks available disk space before writing the SQLCipher database. -->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryDiskSpace</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<!-- E174.1: checking disk space to decide whether to write a file -->
				<string>E174.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
